+                if e.domain == GLib.quark_to_string(Gio.DBusError.quark()):
+                    error_message = strip_dbus_error_prefix(e.message)
+                    print(
+                        f"Failed to apply configuration: {error_message}",
+                        file=sys.stderr,
+                    )
+                else:
+                    print(
+                        f"Failed to apply configuration: {e.message}",
+                        file=sys.stderr,
+                    )
+                sys.exit(1)
