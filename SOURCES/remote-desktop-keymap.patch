+                              G_CALLBACK (update_current_keymap), session);
+  session->keymap_state_changed_handler_id =
+    g_signal_connect_swapped (keymap, "state-changed",
+                              G_CALLBACK (update_current_keymap), session);
+  update_current_keymap (session);
+
