+  if (g_strv_length (priv->display_names) <= priv->effective_layout_group)
+    return NULL;
+
+  short_name = priv->short_names[priv->effective_layout_group];
+  if (g_strcmp0 (short_name, "") == 0)
+    return NULL;
+  else
+    return short_name;
+}
