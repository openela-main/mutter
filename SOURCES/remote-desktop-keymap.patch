+struct _MetaKeymapDescriptionOwner
+{
+  gatomicrefcount ref_count;
+};
+
 struct _MetaKeymapDescription
 {
   gatomicrefcount ref_count;
 
   MetaKeymapDescriptionSource source;
 
+  gboolean is_locked;
+  MetaKeymapDescriptionOwner *owner;
+
   union {
     struct {
       char *rules;
@@ -62,6 +70,31 @@ strdup_or_empty (const char *string)
