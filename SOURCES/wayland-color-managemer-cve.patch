+                                            META_WAYLAND_IMAGE_DESCRIPTION_FLAGS_DEFAULT |
+                                            META_WAYLAND_IMAGE_DESCRIPTION_FLAGS_ALLOW_INFO);
 
   wl_resource_set_implementation (image_desc_resource,
